{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图片对比",
  "mainBinaryName": "image-compare",
  "version": "0.3.1",
  "identifier": "cn.aibbl.image-compare",
  "build": {
    "frontendDist": "../js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "图片对比",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "backgroundColor": "#1a1c22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/**",
          "$HOME/**",
          "/Users/**",
          "/home/**",
          "/Volumes/**",
          "/tmp/**",
          "/private/tmp/**",
          "/mnt/**",
          "/media/**",
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "Utilities",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "webp", "gif", "bmp", "avif", "svg"],
        "name": "图片",
        "description": "图片文件",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  }
}
